# Copy to .env and fill locally. Never commit .env.
# devai  = the 8 agents run as DevAI agents in DevAI flows (DevAI Desktop must be open; run
#          `python -m reqguard.devai setup` once). mock = offline model. openai = any OpenAI-compatible API.
REQGUARD_LLM=devai

# DevAI (local). 127.0.0.1 rather than localhost: on Windows "localhost" tries IPv6 first and
# adds about 2 s to every new connection.
REQGUARD_DEVAI_URL=http://127.0.0.1:7583
REQGUARD_DEVAI_HOST_URL=http://127.0.0.1:7588
REQGUARD_DEVAI_TIMEOUT=180

# Only used when REQGUARD_LLM=openai
REQGUARD_LLM_BASE_URL=https://api.deepseek.com
REQGUARD_LLM_API_KEY=fake-key-for-example-only
REQGUARD_LLM_MODEL=deepseek-chat
REQGUARD_LLM_TIMEOUT=30

REQGUARD_DB=reqguard.db
